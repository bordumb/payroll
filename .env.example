# Copy this file to .env and fill in your key. The real .env is git-ignored.
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which timesheet reader to use: "cloud" (Claude, needs the key above) or
# "local" (Ollama, no key needed). --reader on the command line overrides this.
READER=cloud
